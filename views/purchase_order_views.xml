<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ruta logística del TARIFARIO en la vista PRINCIPAL de la OC:
         datos de captura diaria, siempre a la vista (no en pestañas). -->
    <record id="view_purchase_order_form_tarifario_route" model="ir.ui.view">
        <field name="name">purchase.order.form.tarifario.route</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <!-- Prioridad alta: picking_type_id y effective_date los inyecta la
             vista heredada de purchase_stock, que en esta base se aplica
             DESPUÉS que esta (ParseError real 2026-08-10: el nodo "no se
             puede localizar" aunque se ve en pantalla). Con 200 esta vista
             se aplica al final, cuando el encabezado ya está completo. -->
        <field name="priority">200</field>
        <field name="arch" type="xml">

            <!-- Los helpers invisibles se quedan en la columna izquierda (no
                 ocupan fila); los campos VISIBLES de la ruta viven en su
                 propio grupo de 2 columnas debajo del encabezado, para no
                 desbalancear las dos columnas de la OC. -->
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="som_allowed_country_ids" invisible="1"/>
                <field name="som_allowed_forwarder_ids" invisible="1"/>
                <field name="som_allowed_pol_ids" invisible="1"/>
                <field name="som_allowed_pod_ids" invisible="1"/>
                <field name="som_allowed_naviera_ids" invisible="1"/>
            </xpath>

            <!-- Ocultos por pedido (2026-08-13): Fecha de confirmación,
                 Entrega esperada, Entregar a y Llegada. El espacio de la
                 columna derecha lo ocupa la ruta logística del tarifario. -->
            <xpath expr="//label[@for='date_approve']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='date_approve']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='date_planned']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='date_planned_div']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- not(ancestor::field) = SOLO la instancia del encabezado, no
                 las de los sub-árboles de order_line. El anclaje por hermanos
                 del div reminder varía entre builds de Odoo 19. -->
            <xpath expr="//field[@name='picking_type_id'][not(ancestor::field)]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='effective_date'][not(ancestor::field)]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Ruta logística en la COLUMNA DERECHA del encabezado (el
                 espacio liberado): balancea contra Proveedor / Tipo de
                 Compra / Referencia PI / Moneda de la izquierda. -->
            <xpath expr="//field[@name='date_order'][not(ancestor::field)]/.." position="inside">
                <field name="som_route_country_id"
                       options="{'no_create': True, 'no_open': True}"
                       domain="[('id', 'in', som_allowed_country_ids)]"/>
                <field name="som_route_forwarder_id"
                       options="{'no_create': True, 'no_open': True}"
                       domain="[('id', 'in', som_allowed_forwarder_ids)]"/>
                <field name="som_route_pol_id"
                       options="{'no_create': True, 'no_open': True}"
                       domain="[('id', 'in', som_allowed_pol_ids)]"/>
                <field name="som_route_pod_id"
                       options="{'no_create': True, 'no_open': True}"
                       domain="[('id', 'in', som_allowed_pod_ids)]"/>
                <field name="som_route_naviera_id"
                       options="{'no_create': True, 'no_open': True}"
                       domain="[('id', 'in', som_allowed_naviera_ids)]"/>
                <field name="som_transport_type"/>
                <field name="som_route_etd"/>
            </xpath>

            <!-- Capacidad y arancel POR LÍNEA (vaivén con el producto) -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="before">
                <field name="som_container_capacity" optional="show"/>
                <field name="som_arancel_pct" optional="show"/>
            </xpath>

            <!-- PRECIO SIEMPRE CORREGIBLE: Odoo vuelve el precio unitario de
                 solo lectura cuando la línea ya se recibió/facturó o la orden
                 quedó bloqueada. Regla SOM: el precio de compra se puede
                 corregir mientras la orden no esté cancelada (la valuación de
                 lo ya recibido no se recalcula sola; la factura toma el nuevo
                 precio). -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="attributes">
                <attribute name="readonly">state == 'cancel'</attribute>
            </xpath>

        </field>
    </record>


    <!-- Naviera/Forwarder del embarque, capturables en la RECEPCIÓN si no
         vinieron del portal del proveedor -->
    <record id="view_picking_form_som_carrier" model="ir.ui.view">
        <field name="name">stock.picking.form.som.carrier</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="som_naviera_id"
                       invisible="picking_type_code != 'incoming'"
                       readonly="state == 'done'"
                       options="{'no_create': True}"/>
                <field name="som_forwarder_id"
                       invisible="picking_type_code != 'incoming'"
                       readonly="state == 'done'"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
