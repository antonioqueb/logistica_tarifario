<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_freight_tariff_national_list" model="ir.ui.view">
        <field name="name">freight.tariff.national.list</field>
        <field name="model">freight.tariff.national</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="country_id" optional="show"/>
                <field name="origen"/>
                <field name="destino"/>
                <field name="costo" widget="monetary"/>
                <field name="capacidad"/>
                <field name="transit_time" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_freight_tariff_national_form" model="ir.ui.view">
        <field name="name">freight.tariff.national.form</field>
        <field name="model">freight.tariff.national</field>
        <field name="arch" type="xml">
            <form string="Tarifa Nacional">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Ruta">
                            <field name="country_id"/>
                            <field name="origen"/>
                            <field name="destino"/>
                            <field name="transit_time"/>
                        </group>
                        <group string="Costo">
                            <field name="currency_id" invisible="1"/>
                            <field name="costo" widget="monetary"/>
                            <field name="capacidad"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Notas"><field name="notas" nolabel="1"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_freight_tariff_national_search" model="ir.ui.view">
        <field name="name">freight.tariff.national.search</field>
        <field name="model">freight.tariff.national</field>
        <field name="arch" type="xml">
            <search>
                <field name="origen"/>
                <field name="destino"/>
                <filter name="filter_inactive" string="Archivadas" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_freight_tariff_national" model="ir.actions.act_window">
        <field name="name">Tarifario Nacional</field>
        <field name="res_model">freight.tariff.national</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_freight_tariff_national"
              name="Nacional"
              parent="menu_tarifario_root"
              action="action_freight_tariff_national"
              sequence="15"/>

</odoo>
